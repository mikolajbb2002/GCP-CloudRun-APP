# syntax=docker/dockerfile:1

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace

# Dependency layer first for better caching
COPY pom.xml .
RUN mvn -B -ntp dependency:go-offline

# Copy sources and build (tests should run in CI separately)
COPY src ./src
ARG MAVEN_ARGS="-DskipTests"
RUN mvn -B -ntp clean package ${MAVEN_ARGS}

FROM eclipse-temurin:17-jre-jammy AS runtime
WORKDIR /app

ARG APP_VERSION="1.0.0"
ARG VCS_REF="unknown"
ARG BUILD_DATE="unknown"

LABEL org.opencontainers.image.title="payment-api" \
      org.opencontainers.image.description="Payment API - public REST endpoint for payment processing" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN addgroup --system appgroup \
  && adduser --system --ingroup appgroup --home /app appuser

COPY --from=build --chown=appuser:appgroup /workspace/target/payment-api-*.jar /app/app.jar

USER appuser

ENV JAVA_TOOL_OPTIONS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0"

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
